# systemd user service for `skillsinc sync`; started by skillsinc.timer.
[Unit]
Description=Sync agent customizations with SkillSinc

[Service]
Type=oneshot
ExecStart=%h/.local/bin/skillsinc sync
# Uncomment to match variables set in your shell profile.
#Environment=XDG_CONFIG_HOME=%h/.config
#Environment=XDG_STATE_HOME=%h/.local/state
