{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mikejhill/skillsinc/main/src/skillsinc/config.schema.json",
  "title": "SkillSinc configuration",
  "description": "SkillSinc config.json. Comments and trailing commas are allowed. Reference: https://github.com/mikejhill/skillsinc/blob/main/docs/guides/configuration.md",
  "allowComments": true,
  "allowTrailingCommas": true,
  "type": "object",
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema for editors. SkillSinc keeps ./config.schema.json up to date beside this file."
    },
    "version": {
      "const": 1,
      "description": "Configuration format version. Must be 1."
    },
    "project": {
      "$ref": "#/$defs/text",
      "description": "Project root, relative to this file, that makes this a project configuration."
    },
    "sources": {
      "type": "object",
      "description": "Libraries of authored customizations, by name.",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "destinations": {
      "type": "object",
      "description": "Harness folders that receive customizations, by name.",
      "additionalProperties": {
        "$ref": "#/$defs/destination"
      },
      "properties": {
        "generic": {
          "$ref": "#/$defs/destination",
          "if": {
            "not": {
              "required": [
                "profile"
              ]
            }
          },
          "then": {
            "required": [
              "path"
            ]
          },
          "description": "A destination named generic uses the generic profile unless it names another, and then needs path."
        }
      }
    },
    "profiles": {
      "type": "object",
      "description": "Named sync profiles. Tag routes with them so each machine applies a subset. Selected by --profile, else SKILLSINC_PROFILES, else each profile's default and when.",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "routes": {
      "type": "array",
      "description": "Which items flow from which sources to which destinations.",
      "items": {
        "$ref": "#/$defs/route"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "texts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "selectors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:(?:\\*|skills|instructions|agents|prompts|mcp|resources|hooks)/(?!\\.\\.?(?:/|$))[^/\\\\]*[^/\\\\\\s][^/\\\\]*|plugins/(?!\\.\\.?(?:/|$))[^/\\\\]*[^/\\\\\\s][^/\\\\]*/(?:\\*|skills|instructions|agents|prompts|mcp|resources|hooks)/(?!\\.\\.?(?:/|$))[^/\\\\]*[^/\\\\\\s][^/\\\\]*)$",
        "description": "kind/name or plugins/plugin/kind/name; kind is a supported kind or *; glob patterns allowed."
      }
    },
    "source": {
      "type": "object",
      "description": "Give exactly one of path, github, or git. ref, subdirectory, and refresh apply only to github and git.",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/text",
          "description": "Library directory; relative paths resolve against this file."
        },
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$",
          "description": "GitHub repository owner/repo."
        },
        "git": {
          "$ref": "#/$defs/text",
          "description": "Any Git URL, without credentials."
        },
        "ref": {
          "$ref": "#/$defs/text",
          "description": "Branch, tag, refs/... name, or full commit SHA. Default: the remote's HEAD."
        },
        "subdirectory": {
          "$ref": "#/$defs/text",
          "description": "Relative path, using /, of the library inside the repository."
        },
        "refresh": {
          "type": "string",
          "pattern": "^\\s*(?:(?=\\d)(?:\\d+[dD])?(?:\\d+[hH])?(?:\\d+[mM])?(?:\\d+[sS])?|\\d+:[0-5]\\d(?::[0-5]\\d)?)\\s*$",
          "description": "Shortest time between remote checks, such as 15m, 1h30m, or 0:15, from 1m to 31d. Default: every run."
        },
        "layout": {
          "type": "object",
          "description": "Subdirectory of each kind, and of plugins.",
          "additionalProperties": false,
          "properties": {
            "skills": {
              "$ref": "#/$defs/text"
            },
            "instructions": {
              "$ref": "#/$defs/text"
            },
            "agents": {
              "$ref": "#/$defs/text"
            },
            "prompts": {
              "$ref": "#/$defs/text"
            },
            "mcp": {
              "$ref": "#/$defs/text"
            },
            "resources": {
              "$ref": "#/$defs/text"
            },
            "hooks": {
              "$ref": "#/$defs/text"
            },
            "plugins": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "exclude": {
          "$ref": "#/$defs/texts",
          "description": "File and directory names never read."
        },
        "include": {
          "$ref": "#/$defs/selectors",
          "minItems": 1,
          "description": "Selectors of the items this source offers. Default: [\"*/*\"]."
        },
        "disabled": {
          "$ref": "#/$defs/selectors",
          "description": "Selectors suppressed across every route from this source."
        },
        "rename": {
          "type": "object",
          "description": "New item names by exact kind/name or plugins/plugin/kind/name selector.",
          "additionalProperties": {
            "$ref": "#/$defs/text"
          }
        }
      },
      "oneOf": [
        {
          "title": "Local library",
          "required": [
            "path"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "github"
                ]
              },
              {
                "required": [
                  "git"
                ]
              },
              {
                "required": [
                  "ref"
                ]
              },
              {
                "required": [
                  "subdirectory"
                ]
              },
              {
                "required": [
                  "refresh"
                ]
              }
            ]
          }
        },
        {
          "title": "GitHub repository",
          "required": [
            "github"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "git"
                ]
              }
            ]
          }
        },
        {
          "title": "Git repository",
          "required": [
            "git"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "github"
                ]
              }
            ]
          }
        }
      ]
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "enum": [
            "claude",
            "copilot",
            "vscode",
            "codex",
            "agents",
            "generic"
          ],
          "description": "Harness profile. Default: the destination name."
        },
        "path": {
          "$ref": "#/$defs/text",
          "description": "Directory the harness reads. Required for generic."
        },
        "enabled": {
          "type": "boolean",
          "description": "false skips the destination entirely. Default: true."
        }
      },
      "if": {
        "required": [
          "profile"
        ],
        "properties": {
          "profile": {
            "const": "generic"
          }
        }
      },
      "then": {
        "required": [
          "path"
        ]
      }
    },
    "route": {
      "type": "object",
      "required": [
        "sources",
        "destinations"
      ],
      "additionalProperties": false,
      "properties": {
        "sources": {
          "$ref": "#/$defs/texts",
          "minItems": 1,
          "description": "Source names."
        },
        "destinations": {
          "$ref": "#/$defs/texts",
          "minItems": 1,
          "description": "Destination names."
        },
        "include": {
          "$ref": "#/$defs/texts",
          "description": "kind/name glob patterns to select. Default: [\"*/*\"]."
        },
        "exclude": {
          "$ref": "#/$defs/texts",
          "description": "kind/name glob patterns to drop after include."
        },
        "allow_lossy": {
          "type": "boolean",
          "description": "Accept conversions that drop fields or change activation. Default: false."
        },
        "profiles": {
          "$ref": "#/$defs/texts",
          "description": "Sync profiles this route belongs to; it applies when one is active. Omit to apply on every run."
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "$ref": "#/$defs/text",
          "description": "Shown by skillsinc profiles."
        },
        "default": {
          "type": "boolean",
          "description": "false applies the profile only when selected by --profile or SKILLSINC_PROFILES. Default: true."
        },
        "when": {
          "$ref": "#/$defs/condition",
          "description": "Apply by default only where every listed condition holds. Omit to apply everywhere."
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "$ref": "#/$defs/texts",
          "description": "Host name globs, case-insensitive; matches the full or short name."
        },
        "os": {
          "type": "array",
          "items": {
            "enum": [
              "windows",
              "macos",
              "linux"
            ]
          },
          "description": "Operating systems."
        },
        "env": {
          "type": "object",
          "description": "Environment variable to a value glob, true (set and non-empty), or false (unset or empty).",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "$ref": "#/$defs/text"
              }
            ]
          },
          "propertyNames": {
            "minLength": 1
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "host"
          ],
          "properties": {
            "host": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "os"
          ],
          "properties": {
            "os": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "env"
          ],
          "properties": {
            "env": {
              "minProperties": 1
            }
          }
        }
      ]
    }
  }
}
